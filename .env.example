# Local configuration template. Copy to .env yourself; never commit real secrets.
# Generate a strong random secret locally and use the same value in Swagger's
# Authorize dialog (X-API-Key). Blank means answering is disabled with HTTP 503.
KB_API_KEY=

# Optional: JSON snapshot used by BOTH the server and the CSV import command.
# Relative paths resolve from the directory where the command is started.
KB_STORAGE_PATH=data/kb_topics.json

# Google Sheets read-only synchronization (used by `app.sync_kb --google`).
# Keep the service-account JSON in the ignored credentials/ directory.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
# Comma-separated tabs; blank uses Sheet1.
GOOGLE_SHEET_TABS=Sheet1
